{
	"name": "jc-core-functionality",
	"version": "1.2.0",
	"description": "Core functionality plugin for jasonchafin.com",
	"author": "Jason Chafin <jasonchafin@gmail.com>",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"plugin"
	],
	"homepage": "https://github.com/Herm71/jc-core-functionality#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Herm71/jc-core-functionality.git"
	},
	"bugs": {
		"url": "https://github.com/Herm71/jc-core-functionality/issues"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"directories": {
		"lib": "lib"
	},
	"files": [
		"lib",
		"vendor",
		"acf-json",
		"*.php",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"devDependencies": {
		"@wordpress/prettier-config": "^3.5.0",
		"@wordpress/scripts": "^36.1.0",
		"commit-and-tag-version": "^13.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "npm:wp-prettier@^3.9.6"
	},
	"scripts": {
		"format": "wp-scripts format",
		"lint:style": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"release": "commit-and-tag-version",
		"test": "npm run test:unit && composer test",
		"zip": "wp-scripts plugin-zip",
		"test:unit": "node --test tests/*.test.js",
		"test:php": "composer test",
		"prepare": "husky",
		"lint:php": "composer lint"
	},
	"commit-and-tag-version": {
		"bumpFiles": [
			{
				"filename": "package-lock.json",
				"type": "json"
			},
			{
				"filename": "package.json",
				"type": "json"
			},
			{
				"filename": "plugin.php",
				"updater": "wp-plugin-version-updater.js"
			}
		]
	},
	"lint-staged": {
		"*.php": "vendor/bin/phpcs",
		"*.{js,json,yml,yaml,md}": "wp-scripts format"
	}
}
